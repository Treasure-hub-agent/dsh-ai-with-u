# 依赖
node_modules/
.pnpm-store/

# 构建产物（发布时才生成；源码在 src/ 与 client/）
lib/*.js
lib/*.map
!lib/.gitkeep

# 调试备份
.backup-*/
._*

# 测试与临时
.tmp/
tmp/
*.log
*.tmp

# QA 证据（截图矩阵 / 探针产物）：默认写到**仓库外**的工作区目录，
# 这里再兜一道，防止有人手动 --out 到仓库里把它们提交上去
06-tmp/

# 编辑器
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# 运行时数据（用户数据目录，绝不入库）
.ai-with-u/
*.db
*.sqlite

# 蒸馏过程的临时产物（卡数据 / 旁路脚本）
distill/out/

# 一次性诊断/修复脚本（请放到工作区 06-tmp，不要进仓库）
06-tmp-*.mjs

